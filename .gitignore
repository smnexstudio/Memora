# ---- Build outputs that end up outside build/ ----
*.apk
*.aab
*.ap_
*.dex
mapping.txt
release/
# APK signature files that adb install and apksigner leave next to an APK
*.idsig
# Checksums, SBOMs and notes the release workflow makes; GitHub keeps the published ones
*.sha256
*.cdx.json
/notes.md
# The dependency report's output when run locally (.github/scripts/dependency_report.py)
/report.md

# ---- Logs, crash dumps, profiling ----
*.log
*.hprof
bugreport*.zip
bugreport*/
anr_*
hs_err_pid*
replay_pid*

# ---- Signing keys and secrets ----
# app/debug.keystore is the shared debug key and stays in the repo.
*.jks
*.keystore
!app/debug.keystore
*.p12
*.pem
*.key
keystore.properties
# Base64 copies of a key, made for GitHub secrets
*.b64
*.b64.txt
*.base64
signing.properties
.env
.env.*
google-services.json

# ---- OS files ----
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- Generated demo data (dates are relative to the day it was made) ----
docs/demo/memora-demo-backup.json

