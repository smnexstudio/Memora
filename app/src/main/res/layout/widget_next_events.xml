                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:rotation="-6"
                    android:text="Sent"
                    android:textColor="@color/w_other"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
